    {
      "name": "2 - Required Challenge Scenarios",
      "item": [
        {
          "name": "Full CS Scenario - Validates Clean",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const req = {",
                  "  url: pm.environment.get(\"baseUrl\") + \"/programs\",",
                  "  method: 'POST',",
                  "  header: { 'Content-Type': 'application/json' },",
                  "  body: { mode: 'raw', raw: JSON.stringify({\"name\":\"Computer Science Degree\",\"rootGroup\":{\"name\":\"Core Curriculum\",\"groupRule\":\"inOrder\",\"children\":[{\"type\":\"step\",\"name\":\"Intro to Programming\",\"stepType\":\"session\",\"key\":\"intro\"},{\"type\":\"group\",\"name\":\"Major Selection\",\"groupRule\":\"choice\",\"pickCount\":1,\"key\":\"major\",\"children\":[{\"type\":\"group\",\"name\":\"AI Track\",\"groupRule\":\"inOrder\",\"key\":\"ai\",\"children\":[{\"type\":\"step\",\"name\":\"Machine Learning\",\"stepType\":\"session\",\"key\":\"ml\"},{\"type\":\"step\",\"name\":\"AI Capstone\",\"stepType\":\"test\",\"key\":\"aiCap\",\"prerequisiteRef\":\"ml\"}]},{\"type\":\"group\",\"name\":\"Web Track\",\"groupRule\":\"inOrder\",\"key\":\"web\",\"children\":[{\"type\":\"step\",\"name\":\"Web Dev\",\"stepType\":\"session\",\"key\":\"webDev\"},{\"type\":\"step\",\"name\":\"Web Capstone\",\"stepType\":\"test\",\"key\":\"webCap\",\"prerequisiteRef\":\"webDev\"}]}]},{\"type\":\"step\",\"name\":\"Final Capstone\",\"stepType\":\"test\",\"key\":\"final\",\"prerequisiteRef\":\"major\"}]}}) }",
                  "};",
                  "pm.sendRequest(req, function (err, res) {",
                  "  pm.environment.set(\"testId\", res.json().id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Is valid\", function () { pm.expect(jsonData.isValid).to.be.true; });",
                  "pm.test(\"No impossible prerequisites\", function () { pm.expect(jsonData.impossiblePrerequisites.length).to.eql(0); });",
                  "pm.test(\"No reachability warnings\", function () { pm.expect(jsonData.reachabilityWarnings.length).to.eql(0); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/programs/{{testId}}/validate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "programs",
                "{{testId}}",
                "validate"
              ]
            }
          }
        },
        {
          "name": "Direct Cycle - Rejected",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const body = {",
                  "  name: \"Direct Cycle\",",
                  "  rootGroup: {",
                  "    name: \"Root\", groupRule: \"inOrder\", children: [",
                  "      { type: \"step\", name: \"Step A\", stepType: \"session\", key: \"a\", prerequisiteRef: \"b\" },",
                  "      { type: \"step\", name: \"Step B\", stepType: \"session\", key: \"b\", prerequisiteRef: \"a\" }",
                  "    ]",
                  "  }",
                  "};",
                  "const req = { url: pm.environment.get(\"baseUrl\") + \"/programs\", method: 'POST', header: { 'Content-Type': 'application/json' }, body: { mode: 'raw', raw: JSON.stringify(body) } };",
                  "pm.sendRequest(req, function (err, res) { pm.environment.set(\"testId\", res.json().id); });"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Is invalid\", function () { pm.expect(jsonData.isValid).to.be.false; });",
                  "pm.test(\"Has impossible prerequisites\", function () { pm.expect(jsonData.impossiblePrerequisites.length).to.be.greaterThan(0); });",
                  "pm.test(\"Reason includes forward reference\", function () {",
                  "   const hasForward = jsonData.impossiblePrerequisites.some(p => p.reason === 'forwardReference');",
                  "   pm.expect(hasForward).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/programs/{{testId}}/validate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "programs",
                "{{testId}}",
                "validate"
              ]
            }
          }
        },
